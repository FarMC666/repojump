{
  "name": "repojump-startup",
  "displayName": "RepoJump Startup",
  "description": "Show the startup content requested by RepoJump in its project window.",
  "version": "0.1.1",
  "publisher": "farmc",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": { "supported": false }
  },
  "contributes": {
    "configuration": {
      "title": "RepoJump",
      "properties": {
        "repojump.launchRequest": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "One-time startup request in a workspace managed by RepoJump."
        }
      }
    }
  }
}
